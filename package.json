    "pdfkit": "^0.14.0",
    "pino": "^8.19.0",
    "pino-http": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.10.2",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "uuid": "^9.0.1"
