# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_NAME="Edilegna Lottery"
APP_URL=https://api.edilegna.fmmekelle.com
FRONTEND_URL=https://edilegna.fmmekelle.com
CORS_ORIGINS=https://edilegna.fmmekelle.com,https://api.edilegna.fmmekelle.com

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://edilegnalottery:t1Bb7S4DwG5ZKmRs@localhost:5432/edilegna

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=edilegna_jwt_access_secret_change_this_to_64_random_chars_12345
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_SECRET=edilegna_jwt_refresh_secret_change_this_to_64_random_chars_6789
JWT_REFRESH_EXPIRES_IN=7d

# ── Argon2 ─────────────────────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ── Encryption ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=Edilegna_32CharKey_ChangeThis!!!

# ── File Storage (local disk) ──────────────────────────────────────────────────
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# ── Redis — DISABLED on shared cPanel hosting ──────────────────────────────────
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Email ──────────────────────────────────────────────────────────────────────
SMTP_HOST=mail.fmmekelle.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@fmmekelle.com
SMTP_PASS=YOUR_EMAIL_PASSWORD_HERE
SMTP_FROM="Edilegna Lottery <noreply@fmmekelle.com>"

# ── Rate limiting ──────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Super Admin ────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@lottery.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME="Super Admin"

# ── Pagination ─────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── BullMQ ─────────────────────────────────────────────────────────────────────
BULL_BOARD_ENABLED=false
BULL_BOARD_PATH=/bull-board
