# ── Copy this file to .env and fill in your values ──────────────────────────

# Backend secrets (REQUIRED — change all of these)
JWT_ACCESS_SECRET=change-me-in-production-minimum-32-chars
JWT_REFRESH_SECRET=change-me-refresh-minimum-32-chars-prod
ENCRYPTION_KEY=change-me-exactly-32-chars-here!!

# URLs (set to your domain in production)
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com
VITE_API_URL=https://api.yourdomain.com/api/v1
VITE_APP_NAME="Edilegna | ዕድለኛ"

# JWT expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Edilegna <noreply@yourdomain.com>"
