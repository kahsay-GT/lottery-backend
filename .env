# Application
NODE_ENV=development
PORT=3000
APP_NAME="Lottery SaaS"
APP_URL=http://192.168.1.9:3000
# APP_URL=http://localhost:3000

FRONTEND_URL=http://192.168.1.9:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://192.168.1.9:3001,http://192.168.1.9:3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/lottery_saas?schema=public&host=localhost"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Argon2
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=lottery-saas

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-email-password
SMTP_FROM="Lottery SaaS <noreply@example.com>"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key!!

# Super Admin Seed
SUPER_ADMIN_EMAIL=admin@lotterysaas.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME="Super Admin"

# Sentry (optional)
SENTRY_DSN=

# BullMQ
BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/bull-board

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── Payment Slip Verification ───────────────────────────────────────────────
# CBE (Commercial Bank of Ethiopia) verification API
# Leave blank to use heuristic-only verification
CBE_VERIFY_API_KEY=
CBE_API_BASE_URL=https://api.combanketh.et/v1

# Telebirr verification API
# Leave blank to use heuristic-only verification
TELEBIRR_VERIFY_API_KEY=
TELEBIRR_APP_ID=
TELEBIRR_API_BASE_URL=https://openapi.ethiotelecom.et

# System owner bank account displayed on payment page
SYSTEM_OWNER_ACCOUNT_NAME="Lottery SaaS Platform"
SYSTEM_OWNER_ACCOUNT_NUMBER=1000XXXXXXXXX
SYSTEM_OWNER_BANK_NAME="Commercial Bank of Ethiopia (CBE)"
